{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qr_bill.schema.json",
  "title": "Swiss QR-Rechnung (SPC 0200) · Ergebnis des deterministischen Parsers (Kanal 4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "coding", "iban", "is_qr_iban", "creditor", "amount", "currency", "debtor", "reference_type", "reference", "unstructured_message", "trailer", "bill_information", "swico", "alt_procedures", "validation", "payload_sha256"],
  "properties": {
    "version": { "type": "string", "pattern": "^02[0-9]{2}$" },
    "coding": { "const": "1" },
    "iban": { "type": "string", "pattern": "^(CH|LI)[0-9]{2}[0-9A-Z]{17}$" },
    "is_qr_iban": { "type": "boolean", "description": "IID (Stellen 5–9) im Bereich 30000–31999" },
    "creditor": { "$ref": "#/$defs/address" },
    "amount": { "type": ["number", "null"], "minimum": 0.01, "maximum": 999999999.99 },
    "currency": { "enum": ["CHF", "EUR"] },
    "debtor": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
    "reference_type": { "enum": ["QRR", "SCOR", "NON"] },
    "reference": { "type": ["string", "null"], "maxLength": 27 },
    "unstructured_message": { "type": ["string", "null"], "maxLength": 140 },
    "trailer": { "const": "EPD" },
    "bill_information": { "type": ["string", "null"], "maxLength": 140 },
    "swico": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["invoice_number", "invoice_date", "customer_reference", "uid", "vat_rates", "payment_terms", "due_date"],
      "properties": {
        "invoice_number": { "type": ["string", "null"] },
        "invoice_date": { "type": ["string", "null"], "format": "date" },
        "customer_reference": { "type": ["string", "null"] },
        "uid": { "type": ["string", "null"], "description": "CHE-xxx.xxx.xxx" },
        "vat_rates": { "type": "array", "items": { "type": "string" } },
        "payment_terms": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["discount_pct", "days"],
                     "properties": { "discount_pct": { "type": "number" }, "days": { "type": "integer" } } }
        },
        "due_date": { "type": ["string", "null"], "format": "date", "description": "Rechnungsdatum + Frist mit 0 % Skonto" }
      }
    },
    "alt_procedures": { "type": "array", "maxItems": 2, "items": { "type": "string", "maxLength": 100 } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "errors", "warnings"],
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address_type", "name", "street_or_line1", "building_no_or_line2", "postal_code", "town", "country"],
      "properties": {
        "address_type": { "enum": ["S", "K"], "description": "S = strukturiert (Pflicht seit Nov. 2025), K = kombiniert (alt)" },
        "name": { "type": "string", "maxLength": 70 },
        "street_or_line1": { "type": ["string", "null"], "maxLength": 70 },
        "building_no_or_line2": { "type": ["string", "null"], "maxLength": 70 },
        "postal_code": { "type": ["string", "null"], "maxLength": 16 },
        "town": { "type": ["string", "null"], "maxLength": 35 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    }
  }
}
